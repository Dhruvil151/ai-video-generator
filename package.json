{
  "name": "ai-educational-video-generator",
  "version": "1.0.0",
  "description": "Zero-cost AI-powered educational video generator using Gemini, Edge-TTS, Remotion, and BullMQ.",
  "type": "module",
  "scripts": {
    "dev:server": "nodemon server/server.js",
    "dev:worker": "nodemon server/worker.js",
    "dev:client": "vite",
    "dev": "concurrently -n SERVER,WORKER,CLIENT -c cyan,yellow,green \"npm run dev:server\" \"npm run dev:worker\" \"npm run dev:client\"",
    "build": "vite build",
    "remotion:preview": "remotion preview src/remotion/index.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@remotion/bundler": "^4.0.240",
    "@remotion/cli": "^4.0.240",
    "@remotion/media-utils": "^4.0.240",
    "@remotion/renderer": "^4.0.240",
    "bullmq": "^5.51.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.468.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
