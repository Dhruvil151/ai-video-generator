              "type": "context",
              "text": "function Counter() {"
            },
            {
              "type": "context",
              "text": "  const [count, setCount] = useState(0);"
            },
            {
              "type": "context",
              "text": "  useEffect(() => {"
            },
            {
              "type": "context",
              "text": "    const timer = setInterval(() => {"
            },
            {
              "type": "remove",
              "text": "      setCount(count + 1); // Stale closure!"
            },
            {
              "type": "add",
              "text": "      setCount(prev => prev + 1); // Fresh value!"
            },
            {
              "type": "context",
              "text": "    }, 1000);"
            },
            {
              "type": "context",
              "text": "    return () => clearInterval(timer);"
            },
            {
              "type": "remove",
              "text": "  }, []); // count is trapped in initial closure"
            },
            {
              "type": "add",
              "text": "  }, []); // Safe without dependency"
            },
            {
              "type": "context",
              "text": "}"
            }
