              "engine": "",
              "inputs": {},
              "layout": "fullscreen",
              "code": "interface HasLength {\n  length: number;\n}\n\nfunction logLength<T extends HasLength>(item: T): T {\n  console.log(item.length);\n  return item;\n}\n\nlogLength('hello');   // OK\nlogLength([1, 2, 3]); // OK\nlogLength(123);       // Error: number has no .length",
              "language": "typescript",
