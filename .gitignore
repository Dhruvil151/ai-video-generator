# Dependencies
node_modules/

# Environment variables (NEVER commit this)
.env
.env.local
.env.*.local

# Generated outputs (large binary files)
public/audio/
public/output/

# TTS & scene cache
cache/tts/
cache/scenes/

# Temporary render files
temp/phase4_frames/

# Remotion webpack bundles (generated at runtime)
remotion-webpack-bundle-*

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# API keys (NEVER commit)
gemini-api-keys.local.json
*.local.json

# Build output
dist/

# Logs directory
logs/

# Temp / scratch files
temp/e2e-raw-gemini.json
temp/editor-review/
temp/fixture-review/
temp/review/
tmp/

# Claude runtime state
.claude/scheduled_tasks.lock

# Personal / unrelated files
job-applications/
job_search_24h/
run_job_search.py

# Ensure bundled fonts are committed (needed for offline Remotion render)
!src/remotion/fonts/

# Generated Python bytecode
__pycache__/
*.py[cod]
